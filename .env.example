# Primary provider. Supported values: gemini, openrouter.
AI_PROVIDER=gemini

# Direct Gemini API configuration. Create a key in Google AI Studio.
GEMINI_API_KEY=replace-me
GEMINI_MODEL=gemini-2.5-flash

# Optional fallback when Gemini is unavailable. Also used when
# AI_PROVIDER=openrouter.
OPENROUTER_API_KEY=sk-or-v1-replace-me
OPENROUTER_FALLBACK_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free
OPENROUTER_MODEL=openrouter/free

# Optional for public repositories; required for private repositories.
# Use Contents: Read, Pull requests: Read and write, and Issues: Read when
# publishing reviews that compare a PR with linked issue requirements.
GITHUB_TOKEN=github_pat_replace_me
