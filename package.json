{
  "name": "reviewpilot",
  "version": "1.0.0",
  "description": "A cautious, repository-aware pull request review agent.",
  "type": "module",
  "bin": {
    "reviewpilot": "dist/cli.js"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx src/cli.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "check": "npm run typecheck && npm test"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@google/genai": "^2.18.0",
    "commander": "^14.0.0",
    "dotenv": "^17.2.2",
    "yaml": "^2.8.1",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@types/node": "^24.3.0",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  },
  "keywords": [
    "ai",
    "code-review",
    "github",
    "pull-request",
    "openrouter"
  ],
  "license": "MIT"
}
