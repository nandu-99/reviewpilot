{
  "name": "reviewpilot",
  "version": "1.3.2",
  "description": "AI-powered, repository-aware pull-request review and dependency-aware issue scheduling for GitHub.",
  "author": "nandu-99",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nandu-99/reviewpilot.git"
  },
  "homepage": "https://github.com/nandu-99/reviewpilot#readme",
  "bugs": {
    "url": "https://github.com/nandu-99/reviewpilot/issues"
  },
  "type": "module",
  "bin": {
    "reviewpilot": "dist/cli.js"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx src/cli.ts",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "format": "prettier --write . --ignore-path .gitignore",
    "format:check": "prettier --check . --ignore-path .gitignore",
    "check": "npm run format:check && npm run typecheck && npm test"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@google/genai": "^2.18.0",
    "commander": "^14.0.0",
    "dotenv": "^17.2.2",
    "yaml": "^2.8.1",
    "zod": "^4.6.1"
  },
  "devDependencies": {
    "@types/node": "^24.3.0",
    "@vitest/coverage-v8": "^3.2.7",
    "prettier": "^3.9.6",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "vitest": "^3.2.7"
  },
  "keywords": [
    "ai",
    "code-review",
    "github",
    "github-action",
    "issue-management",
    "project-planning",
    "pull-request",
    "developer-tools",
    "gemini",
    "openrouter"
  ],
  "license": "MIT"
}
